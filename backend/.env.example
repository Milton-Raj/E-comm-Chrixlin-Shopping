# Names and safe local defaults only. Real values: DEPLOYMENT.md §3. Never commit .env.
APP_NAME="Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Storefront (Next.js). Used for CORS, Sanctum and links in emails.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

STORE_NAME="Commerce"
STORE_CURRENCY=INR
STORE_LOCALE=en-IN

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# MySQL 8 locally (deployment/local/docker-compose.yml); MySQL/MariaDB on Hostinger.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecom
DB_USERNAME=ecom
DB_PASSWORD=ecom

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mailpit locally: UI at http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_IDLE_MINUTES=30
# Staff 2FA for the admin API. Ignored in production (always required).
ADMIN_REQUIRE_2FA=true
LOGIN_LOCKOUT_ATTEMPTS=10
HEALTH_TOKEN=

# Local only: fixed password for DemoSeeder accounts (random if empty).
DEMO_PASSWORD=

# Storefront cache refresh after admin changes (ARCHITECTURE §6.17).
REVALIDATE_URL=http://localhost:3000/revalidate
REVALIDATE_SECRET=local-revalidate-secret

# Payments: test gateway is never available in production. Razorpay activates when keys are set.
PAYMENT_TEST_GATEWAY=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket (courier). Use a Shiprocket "API user" (Settings → API), not the main login.
# Packing an order books the pickup; tracking webhooks hit /api/webhooks/delivery-updates with x-api-key = SHIPROCKET_WEBHOOK_TOKEN.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PACKAGE_LENGTH_CM=30
SHIPROCKET_PACKAGE_BREADTH_CM=25
SHIPROCKET_PACKAGE_HEIGHT_CM=10
SHIPROCKET_DEFAULT_WEIGHT_GRAMS=500
