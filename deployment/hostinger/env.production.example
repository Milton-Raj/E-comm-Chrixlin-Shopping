# Production settings for the API on Hostinger (copy to ~/apps/ecom/backend/.env).
# Values marked CHANGE ME must be filled in on the server — never commit real values.

APP_NAME=Chrixlin
APP_ENV=production
APP_KEY=                       # generated on the server: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.chrixlin.com
APP_TIMEZONE=UTC
FRONTEND_URL=https://chrixlin.com

STORE_NAME=Chrixlin
STORE_CURRENCY=INR
STORE_LOCALE=en-IN
STORE_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME          # from hPanel → Databases (looks like u123456789_ecom)
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Cookie login shared between www.chrixlin.com (store) and api.chrixlin.com (API).
SESSION_DRIVER=database
SESSION_DOMAIN=.chrixlin.com
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=chrixlin.com,www.chrixlin.com
CORS_ALLOWED_ORIGINS=https://www.chrixlin.com,https://chrixlin.com

CACHE_STORE=database
QUEUE_CONNECTION=database

# Staff must use two-factor sign-in in production (enforced regardless of this value).
ADMIN_REQUIRE_2FA=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=CHANGE_ME        # e.g. orders@chrixlin.com (create in hPanel → Emails)
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=CHANGE_ME
MAIL_FROM_NAME=Chrixlin

# Online payments: the test gateway is always off in production.
PAYMENT_TEST_GATEWAY=false
RAZORPAY_KEY_ID=               # rzp_live_… (or rzp_test_… while trialling)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PICKUP_LOCATION=Primary

REVALIDATE_URL=https://chrixlin.com/revalidate
REVALIDATE_SECRET=CHANGE_ME    # same long random value as REVALIDATE_SECRET on Vercel
HEALTH_TOKEN=
